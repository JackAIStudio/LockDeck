<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.LockDeck" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- 浮层用透明主题，避免出现白底 -->
    <style name="Theme.LockOverlay" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!-- 透明无动画主题，用于从锁屏跳转的中间页 -->
    <style name="Theme.Transparent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
