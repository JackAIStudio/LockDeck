<?xml version="1.0" encoding="utf-8"?>
<!--
  锁屏天气卡片布局。

  注意：RemoteViews 支持的能力有限，只能用
  LinearLayout / FrameLayout / RelativeLayout / GridLayout
  + TextView / ImageView / Button / ProgressBar 等基础控件。
  不支持 ConstraintLayout、CardView、自定义 View。

  三个独立点击区：
    zone_main   —— 温度 + 天气描述（整块）
    zone_left   —— 今日范围（刷新）
    zone_right  —— 城市 / 状态（打开指定 App）
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- ============ 主区：点这里打开指定 App ============ -->
    <LinearLayout
        android:id="@+id/zone_main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☀"
            android:textSize="26sp"
            android:paddingEnd="10dp" />

        <TextView
            android:id="@+id/tv_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--°"
            android:textSize="34sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- ============ 右侧：点这里打开另一个 App ============ -->
    <TextView
        android:id="@+id/zone_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:gravity="end"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="›"
        android:textSize="22sp" />

    <!-- ============ 左下方：点这里刷新 ============ -->
    <TextView
        android:id="@+id/tv_range"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/zone_main"
        android:layout_alignParentStart="true"
        android:layout_marginTop="4dp"
        android:text="今日 --° ~ --°"
        android:textSize="14sp"
        android:textColor="#B3FFFFFF" />

    <TextView
        android:id="@+id/tv_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_range"
        android:layout_alignParentStart="true"
        android:layout_marginTop="1dp"
        android:text="正在获取天气"
        android:textSize="13sp"
        android:textColor="#99FFFFFF" />

    <!-- 这个透明层盖在左下方两块文字上，把「刷新」动作绑到它们 -->
    <View
        android:id="@+id/zone_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/zone_main"
        android:layout_alignStart="@id/tv_range"
        android:layout_alignEnd="@id/tv_range"
        android:layout_alignBottom="@id/tv_desc"
        android:background="@android:color/transparent" />

</RelativeLayout>
