<?xml version="1.0" encoding="utf-8"?>
<!--
  锁屏小组件卡片

  ┌──────────────────────┬─────────┬─────────┐
  │ ☁ 24°  阴·温州        │  微信   │  支付宝  │
  │ 23°~30° · 02:28      │         │         │
  └──────────────────────┴─────────┴─────────┘
        天气区 ~44%          按钮1     按钮2
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- ============ 天气区（点击打开天气） ============ -->
        <LinearLayout
            android:id="@+id/ov_zone_weather"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.45"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:minHeight="76dp"
            android:paddingStart="15dp"
            android:paddingEnd="10dp"
            android:paddingTop="11dp"
            android:paddingBottom="11dp">

            <!-- 第一行：图标 + 当前温度 + 天气描述 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/ov_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☀"
                    android:textSize="20sp"
                    android:paddingEnd="6dp" />

                <TextView
                    android:id="@+id/ov_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--°"
                    android:textSize="27sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFFFF"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/ov_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text=""
                    android:textSize="13sp"
                    android:textColor="#D9FFFFFF" />
            </LinearLayout>

            <!-- 第二行：最高最低 + 更新时间（合并，不重复） -->
            <TextView
                android:id="@+id/ov_range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textSize="11sp"
                android:textColor="#99FFFFFF" />

            <!-- 降雨提示 -->
            <TextView
                android:id="@+id/ov_rain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text=""
                android:textSize="10sp"
                android:textColor="#FFD58A"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 中缝 -->
        <View
            android:layout_width="1dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#1FFFFFFF" />

        <!-- ============ 按钮 1：微信 ============ -->
        <LinearLayout
            android:id="@+id/ov_zone_app1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:minHeight="76dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/ov_app1_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💬"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/ov_app1_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="微信"
                android:textSize="10sp"
                android:textColor="#CCFFFFFF"
                android:maxLines="1" />
        </LinearLayout>

        <!-- ============ 按钮 2：支付宝 ============ -->
        <LinearLayout
            android:id="@+id/ov_zone_app2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:minHeight="76dp"
            android:paddingTop="10dp"
            android:paddingEnd="4dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/ov_app2_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💳"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/ov_app2_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="支付宝"
                android:textSize="10sp"
                android:textColor="#CCFFFFFF"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
