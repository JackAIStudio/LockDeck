<?xml version="1.0" encoding="utf-8"?>
<!--
  锁屏天气卡片
  左半区 -> 打开天气    右半区 -> 打开闹钟
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- ============ 左半区：打开天气 ============ -->
        <LinearLayout
            android:id="@+id/ov_zone_left"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.05"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:minHeight="92dp"
            android:paddingStart="16dp"
            android:paddingEnd="10dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/ov_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☀"
                    android:textSize="24sp"
                    android:paddingEnd="7dp" />

                <TextView
                    android:id="@+id/ov_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--°"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFFFF"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/ov_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="正在获取天气"
                android:textSize="13sp"
                android:textColor="#CCFFFFFF" />

            <TextView
                android:id="@+id/ov_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text=""
                android:textSize="10sp"
                android:textColor="#80FFFFFF"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 中缝 -->
        <View
            android:layout_width="1dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="18dp"
            android:background="#22FFFFFF" />

        <!-- ============ 右半区：打开闹钟 ============ -->
        <LinearLayout
            android:id="@+id/ov_zone_right"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.95"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:minHeight="92dp"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/ov_range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--° ~ --°"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="今日最高 / 最低"
                android:textSize="11sp"
                android:textColor="#B3FFFFFF" />

            <!-- 降雨提示 -->
            <TextView
                android:id="@+id/ov_rain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textSize="10sp"
                android:textColor="#FFD58A"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
